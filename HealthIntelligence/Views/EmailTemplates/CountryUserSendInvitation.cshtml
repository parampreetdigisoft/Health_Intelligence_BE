@model HealthIntelligence.Views.EmailModels.EmailInvitationSendRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body style="margin:0;padding:0;background-color:#F5F8F7;font-family:'Poppins',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#F5F8F7"
           style="background-color:#F5F8F7;padding:40px 16px;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#ffffff"
                       style="max-width:720px;margin:0 auto;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,0.18);">

                    <tr>
                        <td align="center" bgcolor="#005a62"
                            style="padding:40px 30px 25px;background-color:#005a62;">

                            <img src="cid:ahi-logo"
                                 alt="Africa Health Intelligence"
                                 style="width:auto;max-width:220px;height:auto;max-height:72px;margin:0 auto 20px;display:block;">

                            <div style="font-size:26px;font-weight:600;color:#ffffff;text-align:center;">
                                @Model.Title
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#ffffff"
                            style="padding:35px 40px 25px;font-size:15px;color:#003d44;line-height:1.7;background-color:#ffffff;">

                            <p style="margin:0 0 18px;color:#003d44;">@Model.Name,</p>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                Your Country User account for the <strong style="color:#003d44;">Africa Health Intelligence (AHI)</strong> platform has been activated.
                                You now have access to view and work with country data according to your assigned plan and permissions.
                            </p>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                Please use the secure link below to create your password and access your country user dashboard:
                            </p>

                            <div style="text-align:center;margin:20px 0 20px;">
                                <a href="@Model.ResetPasswordUrl"
                                   style="display:inline-block;padding:14px 28px;background-color:#006D77;background-image:linear-gradient(135deg,#006D77 0%,#4CAF50 52%,#A8E063 100%);color:#ffffff;font-size:16px;border-radius:12px;font-weight:600;text-decoration:none;box-shadow:0 4px 14px rgba(0,109,119,0.28);">
                                    Set Your Password
                                </a>
                            </div>

                            <p style="margin:0 0 16px;color:#003d44;"><strong>As a Country User, you will be able to:</strong></p>

                            <div style="margin:20px 0;padding:18px;background-color:#eef7f1;border-left:4px solid #006D77;border-radius:8px;color:#003d44;font-size:14px;">
                                � Access and view country data based on your assigned plans<br />
                                � Conduct research and gather relevant information for indicators<br />
                                � Update or manage data where permitted under your plan<br />
                                � Monitoring progress and participating in the overall workflow
                            </div>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                If you already have an active password, you may log in directly and continue working according to your assigned plan.
                            </p>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                For support or technical issues, please contact
                                <a href="mailto:@Model.Mail" style="color:#006D77;text-decoration:none;font-weight:600;">
                                    @Model.Mail
                                </a>.
                            </p>
                            <p style="margin:0 0 18px;color:#4a5f62;">
                                Thank you for contributing to the Africa Health Intelligence evaluation process.
                            </p>

                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#F5F8F7"
                            style="padding:25px 40px 35px;text-align:left;background-color:#F5F8F7;font-size:14px;color:#4a5f62;border-top:1px solid #E4E4E4;">
                            <p style="margin:6px 0;color:#003d44;">Warm regards,</p>
                            <p style="margin:6px 0;color:#006D77;font-weight:600;">
                                <strong>Africa Health Intelligence � Platform Administration</strong>
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
