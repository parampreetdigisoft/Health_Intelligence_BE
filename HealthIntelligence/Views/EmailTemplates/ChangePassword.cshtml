@model HealthIntelligence.Views.EmailModels.EmailInvitationSendRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body style="margin:0;padding:0;background-color:#F5F8F7;font-family:'Poppins',Arial,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#F5F8F7"
           style="background-color:#F5F8F7;padding:40px 16px;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#ffffff"
                       style="max-width:720px;margin:0 auto;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,0.18);">

                    <tr>
                        <td align="center" bgcolor="#005a62"
                            style="padding:40px 30px 25px;background-color:#005a62;">

                            <img src="@($"{Model.ApiUrl}/assets/images/ahi.png")" 
                                 alt="Africa Health Intelligence"
                                 style="width:auto;max-width:220px;height:auto;max-height:72px;margin:0 auto 20px;display:block;" />

                            <div style="font-size:28px;font-weight:600;letter-spacing:0.5px;color:#ffffff;max-width:550px;margin:0 auto;">
                                @Model.Title
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#ffffff"
                            style="padding:35px 40px 25px;font-size:15px;color:#003d44;line-height:1.7;background-color:#ffffff;">

                            <p style="margin:0 0 18px;color:#003d44;">Dear User,</p>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                @Model.MsgText
                            </p>

                            <div style="text-align:center;margin:20px 0;">
                                @if (Model.IsShowBtnText)
                                {
                                    <a href="@Model.ResetPasswordUrl"
                                       style="display:inline-block;padding:14px 28px;background-color:#006D77;background-image:linear-gradient(135deg,#006D77 0%,#4CAF50 52%,#A8E063 100%);color:#ffffff;font-size:16px;border-radius:12px;font-weight:600;text-decoration:none;box-shadow:0 4px 14px rgba(0,109,119,0.28);">
                                        @Model.BtnText
                                    </a>
                                }
                                @if (Model.IsLoginBtn)
                                {
                                    <a href="@Model.ApplicationUrl"
                                       style="display:inline-block;padding:14px 28px;background-color:#006D77;background-image:linear-gradient(135deg,#006D77 0%,#4CAF50 52%,#A8E063 100%);color:#ffffff;font-size:16px;border-radius:12px;font-weight:600;text-decoration:none;box-shadow:0 4px 14px rgba(0,109,119,0.28);">
                                        Login
                                    </a>
                                }
                            </div>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                @Model.DescriptionAboutBtnText
                            </p>

                            <p style="margin:0 0 18px;color:#4a5f62;">
                                For assistance, contact
                                <a href="mailto:@Model.Mail"
                                   style="color:#006D77;text-decoration:none;font-weight:600;">
                                    @Model.Mail
                                </a>.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#F5F8F7"
                            style="padding:25px 40px 35px;background-color:#F5F8F7;font-size:14px;color:#4a5f62;border-top:1px solid #E4E4E4;">

                            <p style="margin:6px 0;color:#003d44;">Best regards,</p>

                            <p style="margin:6px 0;color:#006D77;font-weight:600;">
                                <strong>Africa Health Intelligence - Platform Administration</strong>
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
